rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Dono do sistema. Exige e-mail verificado: sem isso, alguém poderia criar
    // uma conta de e-mail/senha com este endereço e ganhar acesso de admin.
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == 'pedro.ms.bogalho@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isOwner() || (isSignedIn() && getUserData().approved == true);
    }

    function isAdmin() {
      return isOwner() || (isApproved() && getUserData().role == 'ADMIN');
    }

    function isAM() {
      return isSignedIn() && getUserData().role == 'AM';
    }

    // User registrations
    match /users/{userId} {
      // Cada um lê o próprio cadastro; o admin lê e gerencia todos.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Cadastro novo: o próprio usuário cria o seu, SEMPRE não aprovado e como
      // ASSISTANT, sem setores. Antes ele podia gravar approved: true e
      // role: 'ADMIN' no próprio documento e se aprovar sozinho.
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.approved == false
        && request.resource.data.role == 'ASSISTANT'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'approved', 'requestDate'])
      );

      // O próprio usuário pode atualizar o seu cadastro, mas nunca os campos de
      // permissão (aprovação, papel, setores) nem a identidade.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['uid', 'email', 'role', 'approved', 'sector', 'sectors'])
      );

      allow delete: if isAdmin();
    }

    // Shared collections (accessible ONLY to approved users)
    match /people/{personId} {
      allow read, create, update: if isApproved();
      // Assistente de Ministro (AM) não exclui pessoas (a tela já bloqueava;
      // agora o banco também).
      // A restrição de edição por setor do AM continua só na tela: o AM
      // acompanha frequentadores de outros setores na Jornada.
      allow delete: if isAdmin() || (isApproved() && !isAM());
    }

    match /families/{familyId} {
      allow read, write: if isApproved();
    }

    match /structures/{structureId} {
      allow read, create, update: if isApproved();
      // Apagar a estrutura inteira só acontece em "Limpar Banco de Dados" (admin).
      allow delete: if isAdmin();
    }

    // Fotos das pessoas (data URL JPEG comprimida no navegador; sem Firebase Storage).
    // Limite de ~300 mil caracteres por foto, bem abaixo do 1 MiB por documento.
    match /fotos_pessoas/{personId} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && request.resource.data.personId == personId
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.dataUrl.size() < 300000;
      allow delete: if isApproved();
    }

    match /logs/{logId} {
      allow create: if isApproved();
      allow read: if isAdmin();
    }
  }
}

